{
    "description": "The KumbiaPHP framework.",
    "homepage": "https://kumbiaphp.com",
    "license": "BSD-3-Clause",
    "name": "kumbia/framework",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "pestphp/pest": "^2 || ^3 || ^4 || ^5",
        "mockery/mockery": "^1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "support": {
        "forum": "http://foro.kumbiaphp.com/",
        "group": "https://groups.google.com/group/kumbia",
        "slack": "https://slack.kumbiaphp.com",
        "source": "https://github.com/KumbiaPHP/KumbiaPHP",
        "wiki": "http://wiki.kumbiaphp.com"
    },
    "type": "project",
    "scripts": {
        "test:core:unit": "pest --colors=always --configuration core/phpunit.xml.dist --test-directory=core/tests/Unit",
        "test:core:feature": "pest --colors=always --configuration core/phpfeature.xml.dist --test-directory=core/tests/Feature",
        "test:core": [
            "@test:core:unit",
            "@test:core:feature"
        ],
        "test": "pest --colors=always --configuration default/app/phpunit.xml.dist --test-directory=default/app/tests",
        "test:all": [
            "@test:core",
            "@test"
        ]
    }
}

